# ============================================================
# .gitignore – Analisis Sentimen Reputasi Undiksha
# ============================================================

# --- Data (jangan commit data mentah/sensitif) ---
data/raw/
data/interim/
data/processed/
data/labeled/
*.csv
*.json
*.parquet
*.pkl
*.h5
*.npy

# Boleh di-track (kecuali file kosong .gitkeep sudah di-track)
!data/**/.gitkeep
!data/interim/slang_dict.json
!data/labeled/annotation_guide.md

# --- Credentials & Environment ---
.env
*.pem
*.key
secrets/

# --- Model & Checkpoint (ukuran besar) ---
/models/
*.pt
*.bin
*.safetensors
/checkpoints/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Virtual Environment ---
.venv/
venv/
env/
.conda/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE & OS ---
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# --- Coverage & Testing ---
.coverage
htmlcov/
.pytest_cache/
.tox/

# --- Logs ---
*.log
logs/

# --- Dokumen Laporan, Proposal, & Logbook Magang (Dikecualikan) ---
*.pdf
format_laporan_akhir_magang*
*proposal*
*Proposal*
reports/*.md
reports/daily_log*
reports/logbook*
reports/laporan*
PRD.md
project-rules.md
PROMPT.md
scratch/
.agent/

# --- Laporan sementara (track hanya hasil final) ---
reports/figures/*.png
reports/figures/*.pdf
!reports/figures/.gitkeep
reports/tables/*.csv
!reports/tables/.gitkeep

